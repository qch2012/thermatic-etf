{
  "$comment": "Checked by pipeline/checks.py before publishing (SPEC 7). Mirrors docs/contract.md. Supports only: type, required, properties, items, enum, pattern, $ref.",
  "type": "object",
  "required": ["data_source", "synthetic", "generated_at", "data_as_of", "weights", "themes", "no_eligible_themes", "funds", "failed_fetches", "missing_issuer_links"],
  "properties": {
    "data_source": {"type": "string"},
    "synthetic": {"type": "boolean"},
    "generated_at": {"type": "string"},
    "data_as_of": {"$ref": "#/$defs/date_or_null"},
    "weights": {"type": "object", "required": ["size", "cost", "performance"],
      "properties": {"size": {"type": "number"}, "cost": {"type": "number"}, "performance": {"type": "number"}}},
    "themes": {"type": "array", "items": {"type": "object",
      "required": ["theme", "group", "window", "candidates", "eligible", "largest_net_assets"],
      "properties": {
        "theme": {"type": "string"}, "group": {"type": "string"},
        "window": {"type": ["object", "null"], "required": ["start", "end", "years", "observations"],
          "properties": {"start": {"$ref": "#/$defs/date"}, "end": {"$ref": "#/$defs/date"}, "years": {"type": "number"}, "observations": {"type": "integer"}}},
        "candidates": {"type": "integer"}, "eligible": {"type": "integer"}, "largest_net_assets": {"type": "number"}}}},
    "no_eligible_themes": {"type": "array", "items": {"type": "object", "required": ["theme", "group", "candidates"],
      "properties": {"theme": {"type": "string"}, "group": {"type": "string"},
        "candidates": {"type": "array", "items": {"type": "object", "required": ["ticker", "name", "status"],
          "properties": {"ticker": {"type": "string"}, "name": {"type": "string"}, "status": {"type": "string"}}}}}}},
    "funds": {"type": "array", "items": {"$ref": "#/$defs/fund"}},
    "failed_fetches": {"type": "array", "items": {"type": "object", "required": ["ticker", "error"],
      "properties": {"ticker": {"type": "string"}, "error": {"type": "string"}}}},
    "missing_issuer_links": {"type": "array", "items": {"type": "string"}},
    "benchmark": {"type": ["string", "null"]},
    "benchmark_trend": {"type": ["object", "null"], "required": ["1m", "3m", "6m", "1y"]},
    "reference": {"type": "array", "items": {"type": "object", "required": ["ticker", "label", "trend"],
      "properties": {"ticker": {"type": "string"}, "label": {"type": "string"},
        "trend": {"type": "object", "required": ["1m", "3m", "6m", "1y"],
          "properties": {"1m": {"$ref": "#/$defs/number_or_null"}, "3m": {"$ref": "#/$defs/number_or_null"},
            "6m": {"$ref": "#/$defs/number_or_null"}, "1y": {"$ref": "#/$defs/number_or_null"}}}}}}
  },
  "$defs": {
    "date": {"type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$"},
    "date_or_null": {"type": ["string", "null"], "pattern": "^\\d{4}-\\d{2}-\\d{2}$"},
    "number_or_null": {"type": ["number", "null"]},
    "fund": {"type": "object",
      "required": ["ticker", "name", "theme", "group", "first_trade_date", "net_assets", "assets_source", "assets_as_of", "assets_stale",
        "expense_ratio", "fetched_at", "stale", "issuer_url", "status", "new", "rank", "score",
        "cumulative_return", "annualized_return", "volatility", "ratio"],
      "properties": {
        "ticker": {"type": "string"}, "name": {"type": "string"}, "theme": {"type": "string"}, "group": {"type": "string"},
        "first_trade_date": {"$ref": "#/$defs/date_or_null"},
        "net_assets": {"$ref": "#/$defs/number_or_null"},
        "assets_source": {"type": "string"},
        "assets_as_of": {"$ref": "#/$defs/date"},
        "assets_stale": {"type": "boolean"},
        "expense_ratio": {"$ref": "#/$defs/number_or_null"},
        "fetched_at": {"type": ["string", "null"]},
        "stale": {"type": "boolean"},
        "issuer_url": {"type": ["string", "null"]},
        "status": {"type": "string"},
        "new": {"type": "boolean"},
        "rank": {"type": ["integer", "null"]},
        "score": {"$ref": "#/$defs/number_or_null"},
        "cumulative_return": {"$ref": "#/$defs/number_or_null"},
        "annualized_return": {"$ref": "#/$defs/number_or_null"},
        "volatility": {"$ref": "#/$defs/number_or_null"},
        "ratio": {"$ref": "#/$defs/number_or_null"},
        "age": {"type": "number"},
        "dollar_volume": {"type": "number"},
        "trend": {"type": "object", "required": ["1m", "3m", "6m", "1y"],
          "properties": {"1m": {"$ref": "#/$defs/number_or_null"}, "3m": {"$ref": "#/$defs/number_or_null"},
            "6m": {"$ref": "#/$defs/number_or_null"}, "1y": {"$ref": "#/$defs/number_or_null"}}},
        "percentiles": {"type": "object", "required": ["size", "cost", "performance"],
          "properties": {"size": {"type": "number"}, "cost": {"type": "number"}, "performance": {"type": "number"}}},
        "performance_unmeasured": {"type": "boolean"},
        "warnings": {"type": "array", "items": {"type": "string"}},
        "top_holdings": {"type": "array", "items": {"type": "object", "required": ["name", "weight"],
          "properties": {"name": {"type": "string"}, "weight": {"type": "number"}}}}
      }}
  }
}
